# Jury reads these from the environment or this file (copy to .env).
# On a machine running Switch Console's local server you can leave the first
# two empty: Jury reads them from Console's own settings.
SWITCH_URL=
SWITCH_REGISTRATION_TOKEN=

# Messaging app display name to create case rooms on (blank = server default)
JURY_BRIDGE=
# Room names
JURY_INTAKE_ROOM=jury-intake
JURY_FLOOR_ROOM=jury-floor
# Agent names of the LLM judges (created by templates/jury-bench.template.yaml)
JURY_JUDGES=jury-inspector,jury-critic
# Human judges to add to every case room, by messaging-app username (comma separated)
JURY_JUDGE_USERS=
# Rubric file (rubrics/flip-the-switch.yaml or rubrics/take-home.yaml or your own)
JURY_RUBRIC=rubrics/flip-the-switch.yaml
# Score gap (0-10) at which Clerk makes two judges argue it out
JURY_DISAGREEMENT_GAP=4
# Hackathon window the Auditor checks commits against
JURY_WINDOW_START=2026-11-04T00:01:00+05:30
JURY_WINDOW_END=2026-11-07T23:59:00+05:30
# Leaderboard web view
JURY_WEB_PORT=8787
